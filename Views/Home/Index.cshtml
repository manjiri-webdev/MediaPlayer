@{
    ViewData["Title"] = "Tata Pack - Media Player";
}

<div class="app-layout">

    <!-- LEFT SIDEBAR (Library removed) -->
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-icon">▶</span>
            <div>
                <h3>Tata Pack</h3>
                <small>Media Player</small>
            </div>
        </div>

        <nav class="sidebar-menu">
            <button type="button" class="sidebar-item active" id="btnNavHome" onclick="showPage('home')">
                🏠 Home
            </button>
            <button type="button" class="sidebar-item" id="btnNavAudio" onclick="showPage('audio')">
                🎵 Audio
            </button>
            <button type="button" class="sidebar-item" id="btnNavVideo" onclick="showPage('video')">
                🎬 Video
            </button>
            <button type="button" class="sidebar-item" id="btnNavPlaylists" onclick="showPage('playlists')">
                📑 Playlists
            </button>
            <button type="button" class="sidebar-item" id="btnNavFavorites" onclick="showPage('favorites')">
                🤍 Favorites
            </button>
        </nav>
    </aside>

    <!-- RIGHT CONTENT AREA -->
    <main class="content-area">

        <!-- TOP SEARCH BAR (Visible on all pages) -->
        <div class="search-bar-row">
            <input 
                type="text" 
                id="searchInput" 
                placeholder="Search songs, videos..." 
                onkeyup="handleGlobalSearch(this.value)" />
        </div>

        <!-- ============================================== -->
        <!-- 1. HOME / ALL MEDIA PAGE -->
        <!-- ============================================== -->
        <section id="pageHome" class="page-section">
            <div class="greeting-box">
                <h2>Good Morning!</h2>
                <p>Your media, your way.</p>
            </div>

            <!-- Filter Pills -->
            <div class="filter-pills">
                <button type="button" class="pill active" onclick="filterHomeMedia('all')">All</button>
                <button type="button" class="pill" onclick="filterHomeMedia('audio')">🎵 Audio</button>
                <button type="button" class="pill" onclick="filterHomeMedia('video')">🎬 Video</button>
            </div>

            <!-- Recently Added Title -->
            <div class="section-header">
                <h3>Recently Added</h3>
            </div>

            <!-- Dynamic Media Grid (Audio + Videos together!) -->
            <div id="homeMediaGrid" class="media-grid">
                Loading all media...
            </div>
        </section>


        <!-- ============================================== -->
        <!-- 2. AUDIO PLAYER PAGE -->
        <!-- ============================================== -->
        <section id="pageAudio" class="page-section" style="display: none;">
            <div class="section-header">
                <h3>← Now Playing Audio</h3>
            </div>

            <div class="audio-two-column">
                <!-- Left: Big Audio Player -->
                <div class="audio-main-player">
                    <div class="audio-art">🎵</div>
                    <h3 id="audioPlayerTitle">Select an audio</h3>
                    <p id="audioPlayerArtist" style="color: #666;">Audio Track</p>

                    <div id="audioElementContainer" style="margin-top: 15px;">
                        <audio id="mainAudioPlayer" controls style="width: 100%;">
                            Your browser does not support audio.
                        </audio>
                    </div>
                </div>

                <!-- Right: Up Next Playlist -->
                <div class="audio-up-next">
                    <h4>Up Next</h4>
                    <div id="audioQueueList" class="audio-list">
                        Loading audio tracks...
                    </div>
                </div>
            </div>
        </section>


        <!-- ============================================== -->
        <!-- 3. VIDEO PLAYER PAGE -->
        <!-- ============================================== -->
        <section id="pageVideo" class="page-section" style="display: none;">
            <div class="section-header">
                <h3>← Now Playing Video</h3>
            </div>

            <div class="video-main-box">
                <!-- Video Screen -->
                <video id="mainVideoPlayer" controls style="width: 100%; max-height: 440px; background: #000; border-radius: 8px;">
                    Your browser does not support video.
                </video>

                <!-- Custom Controls Bar -->
                <div class="video-controls-row">
                    <div class="time-seek-bar">
                        <span id="currentTimeText">00:00</span>
                        <input type="range" id="videoSeekBar" value="0" min="0" step="0.1" style="flex-grow: 1;">
                        <span id="totalDurationText">00:00</span>
                    </div>

                    <div class="video-buttons-bar">
                        <div class="btn-group">
                            <button type="button" onclick="previousVideo()">⏮ Prev</button>
                            <button type="button" id="btnPlayPause" onclick="togglePlayPause()">▶ Play</button>
                            <button type="button" onclick="stopVideo()">⏹ Stop</button>
                            <button type="button" onclick="nextVideo()">⏭ Next</button>
                        </div>

                        <div class="btn-group">
                            <button type="button" id="btnMute" onclick="toggleMute()">🔊</button>
                            <input type="range" id="videoVolume" min="0" max="1" step="0.05" value="1" style="width: 75px;">
                        </div>

                        <div class="btn-group">
                            <label style="font-size: 13px;">Speed:
                                <select id="videoSpeedSelect" onchange="changePlaybackSpeed(this.value)">
                                    <option value="0.5">0.5x</option>
                                    <option value="1" selected>1x</option>
                                    <option value="1.25">1.25x</option>
                                    <option value="1.5">1.5x</option>
                                    <option value="2">2x</option>
                                </select>
                            </label>
                            <button type="button" onclick="toggleFullscreen()">⛶ Fullscreen</button>
                        </div>
                    </div>
                </div>

                <!-- Video Info & Add to Playlist row -->
                <div class="video-info-footer">
                    <div>
                        <h4 id="videoDisplayTitle" style="margin: 0;">Select a video</h4>
                        <small id="videoDisplayMeta" style="color: #666;">Video &bull; 0:00</small>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" onclick="alert('Added to Playlist (Handled by teammate)')">+ Add to Playlist</button>
                        <button type="button" onclick="alert('Added to Favorites (Handled by teammate)')">🤍</button>
                    </div>
                </div>
            </div>

            <!-- Video Library Below Player -->
            <div class="section-header" style="margin-top: 30px;">
                <h3>All Videos</h3>
            </div>
            <div id="videoLibraryGrid" class="media-grid">
                Loading videos...
            </div>
        </section>


        <!-- ============================================== -->
        <!-- 4. PLAYLISTS PAGE (Teammate Placeholder) -->
        <!-- ============================================== -->
        <section id="pagePlaylists" class="page-section" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3>My Playlists</h3>
                <button type="button" onclick="alert('Create playlist feature (handled by teammate)')">+ Create Playlist</button>
            </div>

            <div class="media-grid">
                <div class="static-card">
                    <div class="static-thumb">🎵</div>
                    <strong>Chill Vibes</strong>
                    <small>8 songs &bull; 32 min</small>
                </div>
                <div class="static-card">
                    <div class="static-thumb">🎵</div>
                    <strong>Workout Mix</strong>
                    <small>12 songs &bull; 48 min</small>
                </div>
                <div class="static-card">
                    <div class="static-thumb">🎬</div>
                    <strong>Movie Nights</strong>
                    <small>5 videos &bull; 2 hr 10 min</small>
                </div>
            </div>
        </section>

        <!-- 5. FAVORITES PAGE -->
        <section id="pageFavorites" class="page-section" style="display: none;">
            <div class="section-header">
                <h3>My Favorites</h3>
            </div>
            <p style="color: #777;">Your favorite songs and videos will appear here.</p>
        </section>

    </main>

</div>

@section Scripts {
    <script src="~/js/media-player.js"></script>
    <script src="~/js/video-player.js"></script>
}
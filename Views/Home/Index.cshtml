@{
    ViewData["Title"] = "Tata Pack - Media Player";
}

<div class="app-layout">

    <aside class="sidebar">
        <div class="brand">
            <span class="brand-icon">▶</span>
            <div>
                <h3>Tata Pack</h3>
                <small>Media Player</small>
            </div>
        </div>

        <nav class="sidebar-menu">
            <button type="button" class="sidebar-item active" id="btnNavHome" onclick="showPage('home')">
                <span class="nav-icon">🏠</span> Home
            </button>
            <button type="button" class="sidebar-item" id="btnNavAudio" onclick="showPage('audio')">
                <span class="nav-icon">🎵</span> Audio
            </button>
            <button type="button" class="sidebar-item" id="btnNavVideo" onclick="showPage('video')">
                <span class="nav-icon">🎬</span> Video
            </button>
            <button type="button" class="sidebar-item" id="btnNavPlaylists" onclick="showPage('playlists')">
                <span class="nav-icon">📑</span> Playlists
            </button>
            <button type="button" class="sidebar-item" id="btnNavFavorites" onclick="showPage('favorites')">
                <span class="nav-icon">🤍</span> Favorites
            </button>
        </nav>
    </aside>

    <main class="content-area">

        <div class="search-bar-row">
            <span class="search-icon">🔍</span>
            <input
                type="text"
                id="searchInput"
                placeholder="Search songs, videos..."
                autocomplete="off"
                onkeyup="handleGlobalSearch(this.value)" />
        </div>

        <section id="pageHome" class="page-section">
            <div class="greeting-box">
                <div>
                    <h2>Good Morning!</h2>
                    <p>Your media, your way.</p>
                </div>
            </div>

            <div class="filter-pills">
                <button type="button" class="pill active" onclick="filterHomeMedia('all')">All</button>
                <button type="button" class="pill" onclick="filterHomeMedia('audio')">🎵 Audio</button>
                <button type="button" class="pill" onclick="filterHomeMedia('video')">🎬 Video</button>
            </div>

            <div class="section-header">
                <h3>Recently Added</h3>
                <small class="muted">Tap a card to play</small>
            </div>

            <div id="homeMediaGrid" class="media-grid">
                Loading all media...
            </div>
        </section>

        <section id="pageAudio" class="page-section" style="display: none;">
            <div class="section-header">
                <h3>Now Playing Audio</h3>
                <small class="muted">Sit back and listen</small>
            </div>

            <div class="audio-two-column">
                <div class="audio-main-player">
                    <div class="audio-art">🎵</div>
                    <h3 id="audioPlayerTitle">Select an audio</h3>
                    <p id="audioPlayerArtist" class="muted">Audio Track</p>
                    <div id="audioElementContainer" class="audio-element">
                        <audio id="mainAudioPlayer" controls>
                            Your browser does not support audio.
                        </audio>
                    </div>
                </div>

                <div class="audio-up-next">
                    <h4>Up Next</h4>
                    <div id="audioQueueList" class="audio-list">
                        Loading audio tracks...
                    </div>
                </div>
            </div>
        </section>

        <section id="pageVideo" class="page-section" style="display: none;">
            <div class="section-header">
                <h3>Now Playing Video</h3>
                <small class="muted">Cinema mode at home</small>
            </div>

            <div class="video-main-box">
                <video id="mainVideoPlayer" controls class="video-screen">
                    Your browser does not support video.
                </video>

                <div class="video-controls-row">
                    <div class="time-seek-bar">
                        <span id="currentTimeText">00:00</span>
                        <input type="range" id="videoSeekBar" value="0" min="0" step="0.1" class="seek-range" />
                        <span id="totalDurationText">00:00</span>
                    </div>

                    <div class="video-buttons-bar">
                        <div class="btn-group">
                            <button type="button" class="btn-ghost" onclick="previousVideo()">⏮ Prev</button>
                            <button type="button" class="btn-primary" id="btnPlayPause" onclick="togglePlayPause()">▶ Play</button>
                            <button type="button" class="btn-ghost" onclick="stopVideo()">⏹ Stop</button>
                            <button type="button" class="btn-ghost" onclick="nextVideo()">⏭ Next</button>
                        </div>

                        <div class="btn-group">
                            <button type="button" class="btn-ghost" id="btnMute" onclick="toggleMute()">🔊</button>
                            <input type="range" id="videoVolume" min="0" max="1" step="0.05" value="1" class="volume-range" />
                        </div>

                        <div class="btn-group">
                            <label class="speed-label">Speed:
                                <select id="videoSpeedSelect" onchange="changePlaybackSpeed(this.value)">
                                    <option value="0.5">0.5x</option>
                                    <option value="1" selected>1x</option>
                                    <option value="1.25">1.25x</option>
                                    <option value="1.5">1.5x</option>
                                    <option value="2">2x</option>
                                </select>
                            </label>
                            <button type="button" class="btn-ghost" onclick="toggleFullscreen()">⛶ Fullscreen</button>
                        </div>
                    </div>
                </div>

                <div class="video-info-footer">
                    <div>
                        <h4 id="videoDisplayTitle">Select a video</h4>
                        <small id="videoDisplayMeta" class="muted">Video &bull; 0:00</small>
                    </div>
                    <div class="video-actions">
                        <button type="button" class="btn-ghost" onclick="alert('Added to Playlist (Handled by teammate)')">+ Add to Playlist</button>
                        <button type="button" class="btn-ghost" onclick="alert('Added to Favorites (Handled by teammate)')">🤍</button>
                    </div>
                </div>
            </div>

            <div class="section-header split">
                <h3>All Videos</h3>
            </div>
            <div id="videoLibraryGrid" class="media-grid">
                Loading videos...
            </div>
        </section>

        <section id="pagePlaylists" class="page-section" style="display: none;">
            <div class="section-header split">
                <h3>My Playlists</h3>
                <button type="button" class="btn-primary" onclick="alert('Create playlist feature (handled by teammate)')">+ Create Playlist</button>
            </div>

            <div class="media-grid">
                <div class="static-card">
                    <div class="static-thumb">🎵</div>
                    <strong>Chill Vibes</strong>
                    <small class="muted">8 songs &bull; 32 min</small>
                </div>
                <div class="static-card">
                    <div class="static-thumb">🎵</div>
                    <strong>Workout Mix</strong>
                    <small class="muted">12 songs &bull; 48 min</small>
                </div>
                <div class="static-card">
                    <div class="static-thumb">🎬</div>
                    <strong>Movie Nights</strong>
                    <small class="muted">5 videos &bull; 2 hr 10 min</small>
                </div>
            </div>
        </section>

        <section id="pageFavorites" class="page-section" style="display: none;">
            <div class="section-header">
                <h3>My Favorites</h3>
                <small class="muted">Managed by your teammate</small>
            </div>
            <div class="empty-state">
                <div class="empty-icon">🤍</div>
                <p>Your favorite songs and videos will appear here.</p>
            </div>
        </section>

    </main>

</div>

@section Scripts {
    <script src="~/js/media-player.js"></script>
    <script src="~/js/video-player.js"></script>
}
